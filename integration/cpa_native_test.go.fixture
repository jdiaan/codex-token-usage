// This test is overlaid only into a temporary CPA v7.2.145 checkout.
package auth

import (
 "context"
 "encoding/json"
 "os"
 "testing"

 "github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
 executor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
 "github.com/router-for-me/CLIProxyAPI/v7/sdk/pluginapi"
)

func TestTokenUsageNativeIsolation(t *testing.T) {
 raw,err:=os.ReadFile(os.Getenv("CPA_NATIVE_RESPONSE_FIXTURE")); if err!=nil {t.Fatal(err)}
 var envelope struct { OK bool `json:"ok"`; Result pluginapi.SchedulerPickResponse `json:"result"` }
 if err=json.Unmarshal(raw,&envelope); err!=nil || !envelope.OK {t.Fatalf("plugin response: %s %v",raw,err)}
 if envelope.Result.Handled || envelope.Result.AuthID!="" || envelope.Result.DelegateBuiltin!="" {t.Fatal("plugin took over native selection")}
 ctx:=context.Background()
 for _,strategy:=range []struct{name string; selector Selector}{{"round-robin",&RoundRobinSelector{}},{"weighted",&WeightedRoundRobinSelector{}},{"fill-first",&FillFirstSelector{}}} {
  t.Run(strategy.name,func(t *testing.T){
   manager:=NewManager(nil,strategy.selector,nil)
   manager.executors["codex"]=schedulerTestExecutor{provider:"codex"}
   manager.SetPluginScheduler(&fakePluginScheduler{resp:envelope.Result,handled:false})
   for _,id:=range []string{"a","b","c","d"} {
    priority:="10";if id=="c"||id=="d" {priority="1"}
    _,err:=manager.Register(ctx,&Auth{ID:id,Provider:"codex",Attributes:map[string]string{"priority":priority,"weight":"1"}});if err!=nil {t.Fatal(err)}
    registry.GetGlobalRegistry().RegisterClient(id,"codex",[]*registry.ModelInfo{{ID:"native-model"}})
    t.Cleanup(func(){registry.GetGlobalRegistry().UnregisterClient(id)})
   }
   first,_,err:=manager.pickNext(ctx,"codex","native-model",executor.Options{},nil)
   if err!=nil || (first.ID!="a"&&first.ID!="b") {t.Fatalf("priority: %v %v",first,err)}
   // The same Manager.Update path used by Management PATCH must rebuild the
   // actual candidate pool; this is not a reimplementation of CPA selection.
   for _,id:=range []string{"a","b"} {a,_:=manager.GetByID(id);a.Disabled=true;a.Status=StatusDisabled;if _,err=manager.Update(ctx,a);err!=nil {t.Fatal(err)}}
   for i:=0;i<8;i++ {a,_,e:=manager.pickNext(ctx,"codex","native-model",executor.Options{},nil);if e!=nil || a==nil || (a.ID!="c"&&a.ID!="d") {t.Fatalf("healthy fallback: %v %v",a,e)}}
   a,_:=manager.GetByID("a");a.Disabled=false;a.Status=StatusActive;if _,err=manager.Update(ctx,a);err!=nil {t.Fatal(err)}
   recovered,_,err:=manager.pickNext(ctx,"codex","native-model",executor.Options{},nil);if err!=nil || recovered.ID!="a" {t.Fatalf("recovery: %v %v",recovered,err)}
  })
 }
}
